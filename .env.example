# Debian package mirrors for runtime image
DEBIAN_MIRROR=http://mirrors.ustc.edu.cn/debian
DEBIAN_SECURITY_MIRROR=http://mirrors.ustc.edu.cn/debian-security

# Common tools installed in runtime image.
# LibreOffice and fonts are required for PPT/PPTX/DOC/XLS PDF previews.
APT_PACKAGES=bash ca-certificates curl fonts-dejavu fonts-liberation fonts-noto-cjk libreoffice libreoffice-impress net-tools procps vim wget

# Frontend package registry
NPM_REGISTRY=https://registry.npmmirror.com

# Go module proxy
GO_PROXY=https://goproxy.cn,direct
GO_SUMDB=sum.golang.google.cn

# Optional private module settings
GO_PRIVATE=
GO_NO_SUMDB=

# Host directory mounted into container /data
DATA_DIR=./data

# Runtime resource limits
APP_PORT=8080
APP_CPUS=1.0
APP_MEMORY=1536m
APP_PIDS_LIMIT=256
APP_SHM_SIZE=256m
